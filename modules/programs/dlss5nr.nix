{
  config,
  lib,
  pkgs,
  ...
}:
let
  version = "1.4.0";

  # The release package: OptiScaler, ZLUDA, NVIDIA's networks and the shipped
  # ZLUDA translation cache (gfx1100/gfx1101/gfx11-generic/gfx12-generic/
  # gfx10-3-generic). These are binaries, so they come from the release rather
  # than being rebuilt here.
  release = pkgs.fetchurl {
    url = "https://github.com/RedDukeDev/dlss5-nr-amd-custom/releases/download/${version}/dlss5-nr-amd-custom.zip";
    hash = "sha256-mu0adhb0fD33KmJ//TcHOykmDjOeZ7pwkFkrzFJdioA=";
  };

  # Only the Linux side (the HIP bridge and its trampoline) is rebuilt, so it
  # links against this system's glibc instead of whatever the release was built
  # against.
  src = pkgs.fetchFromGitHub {
    owner = "RedDukeDev";
    repo = "dlss5-nr-amd-custom";
    rev = "3d7eb7cac4a5185455ae029d9a3339369d900f88";
    hash = "sha256-8k94GRtPYwIXVXgy1Ubiy6oiLKs29S6AClPJfMzOBpg=";
  };

  mingw = pkgs.pkgsCross.mingwW64.stdenv.cc;
  hostCc = pkgs.stdenv.cc;

  # ROCm 7 from nixpkgs, for libamdhip64.so.7. libdlss5nr_hip_bridge.so loads
  # it, so it has to be in the package's closure.
  rocm = pkgs.rocmPackages.clr;

  dlss5nr = pkgs.stdenv.mkDerivation {
    pname = "dlss5-nr-amd-custom";
    inherit version src;

    nativeBuildInputs = [
      mingw
      pkgs.unzip
      pkgs.patchelf
    ];

    buildPhase = ''
      runHook preBuild

      # The native half of the HIP bridge. LD_PRELOADed into every process of
      # the Wine session, so it asks for libc and libdl only. Drop the build
      # RPATH: under Steam's container the loader has to use the runtime's
      # glibc, not a Nix one.
      ${hostCc}/bin/gcc -O2 -fPIC -shared -Wall -D_GNU_SOURCE \
        -o libdlss5nr_hip_bridge.so \
        linux/bridge/core.c linux/bridge/generated/thunks.c -ldl
      patchelf --remove-rpath libdlss5nr_hip_bridge.so

      # The Windows half, an ordinary PE DLL named like AMD's own.
      ${mingw}/bin/${mingw.targetPrefix}gcc -O2 -shared -static -D_CRT_SECURE_NO_WARNINGS \
        -o amdhip64_7.dll \
        linux/trampoline/core.c linux/trampoline/generated/exports.c

      runHook postBuild
    '';

    installPhase = ''
      runHook preInstall

      mkdir -p $out/share/dlss5nr $out/bin
      unzip -q ${release} -d release
      cp -a release/dlss5-nr-amd-custom/. $out/share/dlss5nr/

      # Replace the prebuilt Linux binaries with ours.
      install -m755 libdlss5nr_hip_bridge.so $out/share/dlss5nr/linux/
      install -m755 amdhip64_7.dll $out/share/dlss5nr/linux/

      # Keep the upstream launcher, and put a wrapper in front of it that names
      # the ROCm library from the Nix store and shows /nix/store to Steam's
      # container (the store paths ROCm links against are not mounted by
      # default).
      mv $out/share/dlss5nr/linux/launch.sh $out/share/dlss5nr/linux/launch.sh.upstream
      chmod +x $out/share/dlss5nr/linux/launch.sh.upstream
      cat > $out/share/dlss5nr/linux/launch.sh <<'LAUNCH'
#!/bin/sh
# Generated by the Nix package. Points the HIP bridge at ROCm from the Nix
# store and lets Steam's container see it.
export DLSSNR_HIP_LIB="''${DLSSNR_HIP_LIB:-@rocm@/lib/libamdhip64.so.7}"
case "$STEAM_COMPAT_MOUNTS" in
    *"/nix/store"*) ;;
    *) export STEAM_COMPAT_MOUNTS="/nix/store''${STEAM_COMPAT_MOUNTS:+:$STEAM_COMPAT_MOUNTS}" ;;
esac
exec "$(dirname "$(readlink -f "$0")")/launch.sh.upstream" "$@"
LAUNCH
      chmod +x $out/share/dlss5nr/linux/launch.sh
      substituteInPlace $out/share/dlss5nr/linux/launch.sh --subst-var-by rocm ${rocm}

      cat > $out/bin/dlss5nr-install <<'INSTALL'
#!/bin/sh
# Copies the neural rendering package into a game's folder and installs
# OptiScaler there. The files have to be writable: OptiScaler and the runtime
# keep their settings and logs beside themselves.
set -eu

if [ $# -ne 1 ]; then
    echo "usage: dlss5nr-install /path/to/game/folder" >&2
    echo "       (the folder with the game's .exe, e.g. .../Binaries/Win64)" >&2
    exit 2
fi

target=$1
if [ ! -d "$target" ]; then
    echo "dlss5nr-install: $target is not a directory" >&2
    exit 1
fi
target=$(readlink -f "$target")

here=@out@/share/dlss5nr

echo "Copying the neural rendering package into $target ..."
cp -a "$here/." "$target/"
chmod -R u+w "$target"
chmod +x "$target/setup_linux.sh" "$target/linux/launch.sh" 2>/dev/null || true

# Non-interactive where possible; a 32-bit game still takes the bridge path,
# and its launch option is printed by the setup script. Its shebang is
# #!/usr/bin/env bash, which NixOS does not have: run it with bash.
echo
( cd "$target" && bash ./setup_linux.sh --filename=dxgi.dll --overwrite=y \
    --using_nvidia=n --using_dlss=y </dev/null ) || true

# The uninstaller setup writes is run by hand later; give it this package's
# bash so it works outside an FHS environment.
for script in remove_optiscaler.sh; do
    [ -f "$target/$script" ] && sed -i '1s|^#!/usr/bin/env bash|#!@bash@|' "$target/$script"
done

echo
echo "Set the game's Steam launch option to:"
echo "  WINEDLLOVERRIDES=\"dxgi=n,b\" \"$target/linux/launch.sh\" %command%"
echo "(use the option setup_linux.sh printed instead for a 32-bit game)"
INSTALL
      chmod +x $out/bin/dlss5nr-install
      substituteInPlace $out/bin/dlss5nr-install \
        --subst-var-by out $out --subst-var-by bash ${pkgs.bash}/bin/bash

      runHook postInstall
    '';

    meta = {
      description = "DLSS 5 neural rendering on AMD GPUs, through OptiScaler, ZLUDA and ROCm";
      homepage = "https://github.com/RedDukeDev/dlss5-nr-amd-custom";
      license = lib.licenses.mit;
      platforms = [ "x86_64-linux" ];
      sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
    };
  };
in
{
  environment.systemPackages = [ dlss5nr ];
}
